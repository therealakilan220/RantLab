# Copy to .env at the repo root:  cp .env.example .env
# .env is git-ignored. Never commit keys or personal data.

# 1 = no AI models needed (canned card, fake transcript). Good for wiring up and frontend work.
# 0 = real Whisper + Ollama + MiniLM. Delete data/rantlab.db when you switch.
STUB_MODE=1

# Ollama (only used when STUB_MODE=0). Run first:  ollama pull qwen2.5:3b
OLLAMA_URL=http://localhost:11434
OLLAMA_MODEL=qwen2.5:3b

# Optional hosted fallback (Groq / any OpenAI-compatible chat API). Keep off unless Ollama is too slow.
USE_CLOUD_API=0
# CLOUD_API_URL=https://api.groq.com/openai/v1
# CLOUD_API_KEY=
# CLOUD_API_MODEL=llama-3.1-8b-instant

# faster-whisper model size: tiny (fastest) | base | small (most accurate). Pick by laptop speed.
WHISPER_MODEL=base

# Similarity needed to group two complaints. Tune with data/seed.json.
# Defaults: 0.4 in stub mode, 0.6 with real embeddings.
# CLUSTER_THRESHOLD=0.6

# Optional: put the database somewhere else.
# DB_PATH=data/rantlab.db
